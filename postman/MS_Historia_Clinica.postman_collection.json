{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "MS Historia Clínica",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección Postman para probar el microservicio MS Historia Clínica. Requiere que MS Entidades Core esté corriendo (por defecto en http://host.docker.internal:3001/api/v1 si Docker, o http://localhost:3001/api/v1 si local)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005/api/v1"
    },
    {
      "key": "msEntidadesUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "msAgendaUrl",
      "value": "http://localhost:3003/api/v1"
    }
  ],
  "item": [
    {
      "name": "?? Historia Clínica",
      "description": "Gestión de historias Clínicas (CRUD). Requiere pacienteId y sucursalId (obtenidos de ms-entidades).",
      "item": [
        {
          "name": "Listar historias Clínicas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/historia-clinica",
              "host": ["{{baseUrl}}"],
              "path": ["historia-clinica"]
            }
          }
        },
        {
          "name": "Listar historias - filtro por paciente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/historia-clinica?pacienteId=1",
              "host": ["{{baseUrl}}"],
              "path": ["historia-clinica"],
              "query": [{ "key": "pacienteId", "value": "1" }]
            }
          }
        },
        {
          "name": "Listar historias - filtro por sucursal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/historia-clinica?sucursalId=1",
              "host": ["{{baseUrl}}"],
              "path": ["historia-clinica"],
              "query": [{ "key": "sucursalId", "value": "1" }]
            }
          }
        },
        {
          "name": "Listar historias - filtro por pago",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/historia-clinica?pagado=true",
              "host": ["{{baseUrl}}"],
              "path": ["historia-clinica"],
              "query": [{ "key": "pagado", "value": "true" }]
            }
          }
        },
        {
          "name": "Listar historias - rango de fechas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/historia-clinica?desde=2026-04-01T00:00:00&hasta=2026-04-30T23:59:59",
              "host": ["{{baseUrl}}"],
              "path": ["historia-clinica"],
              "query": [
                { "key": "desde", "value": "2026-04-01T00:00:00" },
                { "key": "hasta", "value": "2026-04-30T23:59:59" }
              ]
            }
          }
        },
        {
          "name": "Obtener historia por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/historia-clinica/1",
