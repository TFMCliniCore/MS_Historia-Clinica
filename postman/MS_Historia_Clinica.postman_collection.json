          }
        },
        {
          "name": "Crear historia Clínica",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2026-05-20T10:30:00\",\n  \"pacienteId\": 1,\n  \"sucursalId\": 1,\n  \"motivo\": \"Revisión general anual\",\n  \"sintomas\": \"Sin síntomas aparentes\",\n  \"diagnostico\": \"Paciente sano\",\n  \"tratamiento\": \"Desparasitación interna y externa\",\n  \"notas\": \"Próxima vacuna en 3 meses\",\n  \"costo\": 85000,\n  \"pagado\": true,\n  \"formaPago\": \"Efectivo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/historia-clinica",
              "host": ["{{baseUrl}}"],
              "path": ["historia-clinica"]
            }
          }
        },
        {
          "name": "Actualizar historia (PATCH)",
          "request": {
